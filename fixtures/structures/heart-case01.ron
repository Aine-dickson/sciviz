    reference: "Rodero C. et al. (2021), Linking statistical shape models and simulated function in the healthy adult human heart, PLoS Comput Biol 17(4): e1008851; data: https://doi.org/10.5281/zenodo.4590294 (CC BY 4.0), case 01. One individual's CT-derived anatomy, not a canonical heart; valves are planes and chambers are the empty space between the walls.",
    circle_segments: 24,
    parts: [
        Part(id: "heart", name: "Human heart", parent: None, description: "A human heart reconstructed from one healthy adult's CT scan: four chambers, the great vessels near the heart, and the four valve positions.", colour: (0.8, 0.4, 0.4)),
        Part(id: "chamber-walls", name: "Chamber walls", parent: Some("heart"), description: "The muscular walls of the four chambers.", colour: (0.8, 0.4, 0.4)),
        Part(id: "great-vessels", name: "Great vessels and vein ends", parent: Some("heart"), description: "The arteries leaving the heart and the veins entering it, as short segments next to the heart.", colour: (0.6, 0.4, 0.6)),
        Part(id: "vessel-ends", name: "Vein ends", parent: Some("great-vessels"), description: "The pulmonary veins, venae cavae and left atrial appendage opening into the atria.", colour: (0.6, 0.3, 0.5)),
        Part(id: "valve-planes", name: "Valve planes", parent: Some("heart"), description: "The four valves, each modelled in this data as a flat plane across its opening.", colour: (0.95, 0.85, 0.35)),
        Part(id: "chambers", name: "Chamber cavities", parent: Some("heart"), description: "The blood-filled space inside each chamber, shown as a cast. The data has no blood-pool mesh: these are the empty spaces enclosed by the walls and valve planes.", colour: (0.5, 0.3, 0.6)),
        Part(id: "left-ventricle", name: "Left ventricle wall", parent: Some("chamber-walls"), description: "The muscular wall of the left ventricle, the thickest wall of the heart, as segmented from this individual's CT scan. It pumps blood to the body through the aortic valve.", colour: (0.78, 0.33, 0.31), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-ventricle"))),
        Part(id: "right-ventricle", name: "Right ventricle wall", parent: Some("chamber-walls"), description: "The wall of the right ventricle, thinner than the left, lying in front of it. It pumps blood to the lungs through the pulmonary valve.", colour: (0.82, 0.56, 0.52), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-ventricle"))),
        Part(id: "left-atrium", name: "Left atrium wall", parent: Some("chamber-walls"), description: "The wall of the left atrium, which receives blood from the lungs through the pulmonary veins and passes it to the left ventricle.", colour: (0.86, 0.55, 0.56), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-atrium"))),
        Part(id: "right-atrium", name: "Right atrium wall", parent: Some("chamber-walls"), description: "The wall of the right atrium, which receives blood from the body through the venae cavae and passes it to the right ventricle.", colour: (0.88, 0.66, 0.62), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-atrium"))),
        Part(id: "aorta", name: "Aorta (wall near the heart)", parent: Some("great-vessels"), description: "The first part of the aorta where it leaves the left ventricle. The data holds the vessel wall near the heart only; its lumen is not modelled.", colour: (0.86, 0.24, 0.20), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "aorta"))),
        Part(id: "pulmonary-artery", name: "Pulmonary artery (wall near the heart)", parent: Some("great-vessels"), description: "The first part of the pulmonary artery where it leaves the right ventricle. The data holds the vessel wall near the heart only; its lumen is not modelled.", colour: (0.36, 0.46, 0.82), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "pulmonary-artery"))),
        Part(id: "mitral-valve-plane", name: "Mitral valve plane", parent: Some("valve-planes"), description: "A one-element-thick plane that closes the opening between the left atrium and left ventricle. The data models the valve as a plane, not as leaflets.", colour: (0.95, 0.84, 0.30), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "mitral-valve-plane"))),
        Part(id: "tricuspid-valve-plane", name: "Tricuspid valve plane", parent: Some("valve-planes"), description: "A one-element-thick plane that closes the opening between the right atrium and right ventricle. The data models the valve as a plane, not as leaflets.", colour: (0.95, 0.80, 0.28), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "tricuspid-valve-plane"))),
        Part(id: "aortic-valve-plane", name: "Aortic valve plane", parent: Some("valve-planes"), description: "A one-element-thick plane at the exit of the left ventricle into the aorta. The data models the valve as a plane, not as cusps.", colour: (0.96, 0.88, 0.40), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "aortic-valve-plane"))),
        Part(id: "pulmonary-valve-plane", name: "Pulmonary valve plane", parent: Some("valve-planes"), description: "A one-element-thick plane at the exit of the right ventricle into the pulmonary artery. The data models the valve as a plane, not as cusps.", colour: (0.96, 0.84, 0.36), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "pulmonary-valve-plane"))),
        Part(id: "left-atrial-appendage", name: "Left atrial appendage (inlet segment)", parent: Some("vessel-ends"), description: "The opening of the left atrial appendage, a pouch off the left atrium, shown as the short inlet segment the data holds.", colour: (0.84, 0.46, 0.46), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-atrial-appendage"))),
        Part(id: "left-superior-pulmonary-vein", name: "Left superior pulmonary vein (inlet segment)", parent: Some("vessel-ends"), description: "The upper left pulmonary vein, which brings oxygenated blood from the left lung. Shown as the short inlet segment the data holds.", colour: (0.82, 0.22, 0.26), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-superior-pulmonary-vein"))),
        Part(id: "left-inferior-pulmonary-vein", name: "Left inferior pulmonary vein (inlet segment)", parent: Some("vessel-ends"), description: "The lower left pulmonary vein, which brings oxygenated blood from the left lung. Shown as the short inlet segment the data holds.", colour: (0.80, 0.20, 0.24), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-inferior-pulmonary-vein"))),
        Part(id: "right-inferior-pulmonary-vein", name: "Right inferior pulmonary vein (inlet segment)", parent: Some("vessel-ends"), description: "The lower right pulmonary vein, which brings oxygenated blood from the right lung. Shown as the short inlet segment the data holds.", colour: (0.78, 0.20, 0.24), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-inferior-pulmonary-vein"))),
        Part(id: "right-superior-pulmonary-vein", name: "Right superior pulmonary vein (inlet segment)", parent: Some("vessel-ends"), description: "The upper right pulmonary vein, which brings oxygenated blood from the right lung. Shown as the short inlet segment the data holds.", colour: (0.84, 0.24, 0.28), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-superior-pulmonary-vein"))),
        Part(id: "superior-vena-cava", name: "Superior vena cava (inlet segment)", parent: Some("vessel-ends"), description: "The large vein that returns blood from the upper body to the right atrium. Shown as the short inlet segment the data holds.", colour: (0.30, 0.40, 0.80), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "superior-vena-cava"))),
        Part(id: "inferior-vena-cava", name: "Inferior vena cava (inlet segment)", parent: Some("vessel-ends"), description: "The large vein that returns blood from the lower body to the right atrium. Shown as the short inlet segment the data holds.", colour: (0.26, 0.36, 0.76), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "inferior-vena-cava"))),
        Part(id: "left-ventricle-cavity", name: "Left ventricle cavity", parent: Some("chambers"), description: "The space inside the left ventricle, shown as a cast: empty in the data, closed by the mitral and aortic valve planes. Red by convention for oxygenated blood.", colour: (0.74, 0.10, 0.10), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-ventricle-cavity"))),
        Part(id: "right-ventricle-cavity", name: "Right ventricle cavity", parent: Some("chambers"), description: "The space inside the right ventricle, shown as a cast: empty in the data, closed by the tricuspid and pulmonary valve planes. Blue by convention for deoxygenated blood.", colour: (0.20, 0.30, 0.74), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-ventricle-cavity"))),
        Part(id: "left-atrium-cavity", name: "Left atrium cavity", parent: Some("chambers"), description: "The space inside the left atrium, shown as a cast, closed by the mitral valve plane and the pulmonary vein and appendage inlets. Red by convention.", colour: (0.80, 0.16, 0.16), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "left-atrium-cavity"))),
        Part(id: "right-atrium-cavity", name: "Right atrium cavity", parent: Some("chambers"), description: "The space inside the right atrium, shown as a cast, closed by the tricuspid valve plane and the vena cava inlets. Blue by convention.", colour: (0.26, 0.36, 0.80), geometry: Some(Mesh(file: "heart-case01.svfmesh", body: "right-atrium-cavity"))),
