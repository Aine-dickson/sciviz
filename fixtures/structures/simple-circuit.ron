                        Highlight(part: "lamp", at_s: 9.0),
                    ]),
                    Beat(id: "open", actions: [
                        Narrate(text: "The switch is open: its lever is up, leaving a gap. The loop is broken, so no charge flows round. There is no current, and the lamp is off.", for_s: 9.0),
                        Highlight(part: "switch-lever"),
                    ]),
                    Beat(id: "current", actions: [
                        Narrate(text: "Close the switch. The lever touches the contact and the loop is complete.", for_s: 3.0, at_s: 0.0),
