                    Beat(id: "parts", actions: [
                        Narrate(text: "A simple circuit. The cell (bottom) pushes charge round. Copper wires join it to a switch (left) and a lamp (top). Every part is joined into one loop.", for_s: 12.0),
                        Highlight(part: "cell"),
