// Dicot stem, transverse layout. Schematic proportions, NOT measured data.
// Axis is +Y; look down the axis to see the transverse arrangement.
Structure(
    version: 1,
    name: "Dicot stem (transverse layout)",
    units: "mm",
    reference: "To be confirmed by the author: standard textbook transverse arrangement of a dicot stem (epidermis, cortex, ring of vascular bundles with phloem outside xylem, pith). Proportions are schematic.",
    circle_segments: 48,
    parts: [
        Part(id: "stem", name: "Dicot stem", parent: None,
             description: "A young herbaceous dicot stem. Tissues are arranged in concentric zones, with the vascular bundles in a ring.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "epidermis", name: "Epidermis", parent: Some("stem"),
             description: "Single outer layer of cells. Protects the stem and limits water loss.",
             colour: (0.35, 0.65, 0.30),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Annulus(inner: 4.7, outer: 5.0)))),
        Part(id: "cortex", name: "Cortex", parent: Some("stem"),
             description: "Parenchyma between the epidermis and the vascular ring. Stores food and gives support.",
             colour: (0.70, 0.85, 0.45),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Annulus(inner: 3.6, outer: 4.7)))),
        Part(id: "vascular-bundles", name: "Vascular bundles", parent: Some("stem"),
             description: "Eight bundles in a ring. Each has xylem toward the pith and phloem toward the outside, with cambium between them.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "phloem", name: "Phloem", parent: Some("vascular-bundles"),
             description: "Carries sugars made in the leaves to the rest of the plant. Outer part of each bundle.",
             colour: (0.90, 0.55, 0.15),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Sector(inner: 2.95, outer: 3.6, width_deg: 30.0, first_angle_deg: 0.0, count: 8)))),
        Part(id: "vascular-cambium", name: "Vascular cambium", parent: Some("vascular-bundles"),
             description: "Thin layer of dividing cells between phloem and xylem. Adds new xylem and phloem as the stem thickens.",
             colour: (0.95, 0.90, 0.30),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Sector(inner: 2.85, outer: 2.95, width_deg: 30.0, first_angle_deg: 0.0, count: 8)))),
        Part(id: "xylem", name: "Xylem", parent: Some("vascular-bundles"),
             description: "Carries water and minerals up from the roots and supports the stem. Inner part of each bundle.",
             colour: (0.80, 0.25, 0.25),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Sector(inner: 2.2, outer: 2.85, width_deg: 30.0, first_angle_deg: 0.0, count: 8)))),
        Part(id: "medullary-rays", name: "Medullary rays", parent: Some("stem"),
             description: "Parenchyma between the bundles, joining the cortex to the pith.",
             colour: (0.60, 0.78, 0.55),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Sector(inner: 2.2, outer: 3.6, width_deg: 15.0, first_angle_deg: 22.5, count: 8)))),
        Part(id: "pith", name: "Pith", parent: Some("stem"),
             description: "Parenchyma at the centre of the stem. Stores food.",
             colour: (0.95, 0.95, 0.80),
             geometry: Some(Extrusion(axis_length: 12.0, profile: Disc(radius: 2.2)))),
    ],
    // Outermost first: the order of removal when peeling.
    layers: [
        Layer(id: "epidermis", name: "Epidermis", parts: ["epidermis"]),
        Layer(id: "cortex", name: "Cortex", parts: ["cortex"]),
        Layer(id: "vascular", name: "Vascular ring", parts: ["vascular-bundles", "medullary-rays"]),
        Layer(id: "pith", name: "Pith", parts: ["pith"]),
    ],
)
