                        Flow(id: "water-0", count: 3, path: [(-7.20, 8.00, 1.80), (-9.60, 8.00, 1.80)], speed: 1.0, lateral: 0.2, seed: 80, particle_radius: 0.28, colour: (0.35, 0.65, 1.0), for_s: 12.0, at_s: 0.0),
