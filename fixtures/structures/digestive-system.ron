    ],
    // Outermost (front) first: the order of removal when peeling.
    layers: [
        Layer(id: "large-intestine", name: "Large intestine", parts: ["large-intestine"]),
        Layer(id: "liver", name: "Liver", parts: ["liver"]),
        Layer(id: "small-intestine", name: "Small intestine", parts: ["small-intestine"]),
        Layer(id: "stomach", name: "Stomach", parts: ["stomach"]),
        Layer(id: "upper-tube", name: "Mouth and gullet", parts: ["mouth", "oesophagus"]),
    ],
    views: [
        View(id: "whole", name: "The whole digestive system",
             camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.0)),
             show: ["digestive-system"], peel: 0, section: None),
        View(id: "upper", name: "Mouth, gullet, stomach and liver",
             camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.5)),
             show: ["mouth", "oesophagus", "stomach", "liver"], peel: 0, section: None),
        View(id: "intestines", name: "The intestines",
             camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.5)),
             show: ["small-intestine", "large-intestine"], peel: 0, section: None),
    ],
    // One bite of food, followed from mouth to rectum, one organ at a time.
    timelines: [
        Timeline(id: "digestion", name: "Following a bite of food",
            camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.0)),
            scenes: [
                Scene(id: "digestion", beats: [
                    Beat(id: "whole", actions: [
                        Narrate(text: "Food is broken down in a long tube called the digestive system, so that the body can take in what it needs. Let us follow a bite of food through it.", for_s: 8.0),
                    ]),
                    Beat(id: "mouth", actions: [
                        Narrate(text: "The mouth: teeth chew the food into small pieces and saliva makes it wet and starts to break it down.", for_s: 8.0),
                        Highlight(part: "mouth"),
                        Spread(id: "chewing", count: 14, from: (0.0, 40.5, 0.5), radius: 0.5, inside: Ball(centre: (0.0, 40.5, 0.5), radius: 1.3), step: 0.12, seed: 5, particle_radius: 0.22, colour: (0.92, 0.82, 0.55), for_s: 8.0, stay: false),
                    ]),
                    Beat(id: "oesophagus", actions: [
                        Narrate(text: "The food is swallowed. The oesophagus (gullet) squeezes it down towards the stomach with waves of muscle.", for_s: 8.0),
                        Highlight(part: "oesophagus"),
                        Flow(id: "swallow", count: 6, path: [(0.00, 39.20, 0.00), (0.00, 34.00, 0.00), (0.50, 30.00, 0.00), (1.50, 28.30, 0.00)], speed: 2.5, lateral: 0.3, seed: 6, particle_radius: 0.3, colour: (0.92, 0.82, 0.55), for_s: 8.0, at_s: 0.0),
                    ]),
                    Beat(id: "stomach", actions: [
                        Narrate(text: "The stomach churns the food with strong acid and digestive juices, turning it into a thick liquid.", for_s: 10.0),
                        Highlight(part: "stomach"),
                        Spread(id: "churning", count: 30, from: (1.8, 27.2, 0.0), radius: 0.4, inside: Ball(centre: (3.0, 25.0, 0.0), radius: 3.0), step: 0.28, seed: 7, particle_radius: 0.28, colour: (0.80, 0.62, 0.35), for_s: 10.0, stay: false),
                    ]),
                    Beat(id: "liver", actions: [
                        Narrate(text: "The liver makes bile, a green juice that helps to break up fats. It is stored in a small bag and added to the food in the small intestine.", for_s: 8.0),
                        Highlight(part: "liver"),
                    ]),
                    Beat(id: "small-intestine", actions: [
                        Narrate(text: "The small intestine is a long, coiled tube. Food is broken down into very small pieces, and these nutrients pass through the wall into the blood.", for_s: 14.0),
