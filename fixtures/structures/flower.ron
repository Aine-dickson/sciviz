// Generic flower, schematic, lengthwise layout. Proportions are invented, NOT measured data.
// Proof of concept for the item register (docs/item-output-bar.md); not for lessons as it stands.
// Axis is +Y (stalk below, stigma above). Section along z for a lengthwise cut.
// A flower of this kind has five sepals, five petals, eight stamens and one carpel (ovary, style, stigma).
// The fruit stage is drawn in the same place as the flower so that views can swap between them;
// with no view chosen both show at once. Peel one layer to remove the fruit stage.
Structure(
    version: 1,
    name: "Generic flower and fruit (lengthwise layout)",
    units: "mm",
    reference: "To be confirmed by the author: standard textbook arrangement of a complete flower (sepals, petals, stamens, carpel) and its ovary developing into a fruit with seeds. Schematic proportions.",
    circle_segments: 32,
    parts: [
        Part(id: "flower", name: "Flower", parent: None,
             description: "A complete flower: it has sepals, petals, stamens and a carpel. Seeds form from its ovules after pollination.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "peduncle", name: "Stalk (peduncle)", parent: Some("flower"),
             description: "Holds the flower up and carries water and food to it.",
             colour: (0.35, 0.60, 0.25),
             geometry: Some(Tube(path: [(0.0, -13.0, 0.0), (0.0, -8.0, 0.0), (0.0, -3.0, 0.0)], half_widths: [(1.3, 1.3), (1.3, 1.3), (1.5, 1.5)], up: (0.0, 0.0, 1.0)))),
        Part(id: "receptacle", name: "Receptacle", parent: Some("flower"),
             description: "The swollen top of the stalk. The sepals, petals, stamens and carpel are attached to it.",
             colour: (0.50, 0.70, 0.30),
             geometry: Some(Ellipsoid(centre: (0.0, -1.5, 0.0), radii: (3.6, 2.2, 3.6)))),
        Part(id: "sepals", name: "Sepals", parent: Some("flower"),
             description: "Five small green leaves at the base of the flower. They protect the bud before it opens.",
             colour: (0.30, 0.65, 0.30),
             geometry: Some(Ellipsoid(centre: (4.0451, -0.6, -2.9389), radii: (4.5, 0.5, 1.6), rotate_deg: (0.0, 36.0, 0.0))),
             repeat: Some(Radial(count: 5, axis_point: (0.0, 0.0, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
        Part(id: "petals", name: "Petals", parent: Some("flower"),
             description: "Five coloured leaves. Their colour and scent attract insects that carry pollen.",
             colour: (0.90, 0.35, 0.55),
             geometry: Some(Ellipsoid(centre: (7.0, 3.5, 0.0), radii: (5.0, 0.6, 2.4), rotate_deg: (0.0, 0.0, 40.0))),
             repeat: Some(Radial(count: 5, axis_point: (0.0, 0.0, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
        Part(id: "stamens", name: "Stamens", parent: Some("flower"),
             description: "The male parts. Each has a thin filament that holds up an anther.",
             colour: (0.95, 0.80, 0.25), geometry: None),
        Part(id: "filaments", name: "Filaments", parent: Some("stamens"),
             description: "Thin stalks that hold the anthers up (eight shown).",
             colour: (0.95, 0.85, 0.55),
             geometry: Some(Tube(path: [(3.4, -1.0, 0.0), (3.6, 2.5, 0.0), (3.8, 6.0, 0.0)], half_widths: [(0.15, 0.15), (0.15, 0.15), (0.15, 0.15)], up: (0.0, 0.0, 1.0))),
             repeat: Some(Radial(count: 8, axis_point: (0.0, 0.0, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
        Part(id: "anthers", name: "Anthers", parent: Some("stamens"),
             description: "They make the pollen. When ripe they split open and release it.",
             colour: (0.90, 0.60, 0.10),
             geometry: Some(Ellipsoid(centre: (3.8, 6.6, 0.0), radii: (0.5, 0.9, 0.5))),
             repeat: Some(Radial(count: 8, axis_point: (0.0, 0.0, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
        Part(id: "carpel", name: "Carpel", parent: Some("flower"),
             description: "The female part at the centre: the stigma, the style and the ovary.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "stigma", name: "Stigma", parent: Some("carpel"),
             description: "The sticky top where pollen lands.",
             colour: (0.60, 0.80, 0.30),
             geometry: Some(Ellipsoid(centre: (0.0, 8.6, 0.0), radii: (0.9, 0.6, 0.9)))),
        Part(id: "style", name: "Style", parent: Some("carpel"),
             description: "The stalk that joins the stigma to the ovary. A pollen tube grows down through it.",
             colour: (0.70, 0.85, 0.40),
             geometry: Some(Tube(path: [(0.0, 3.2, 0.0), (0.0, 6.0, 0.0), (0.0, 8.3, 0.0)], half_widths: [(0.35, 0.35), (0.35, 0.35), (0.35, 0.35)], up: (0.0, 0.0, 1.0)))),
        Part(id: "ovary", name: "Ovary", parent: Some("carpel"),
             description: "The swollen base of the carpel. It is hollow and holds the ovules.",
             colour: (0.55, 0.78, 0.35),
             geometry: Some(Ellipsoid(centre: (0.0, 0.8, 0.0), radii: (2.6, 2.8, 2.6), wall: Some(0.35)))),
        Part(id: "ovules", name: "Ovules", parent: Some("carpel"),
             description: "Small bodies inside the ovary (six shown). Each can become a seed if it is fertilised.",
             colour: (0.95, 0.95, 0.70),
             geometry: Some(Ellipsoid(centre: (1.3, 0.8, 0.0), radii: (0.55, 0.55, 0.55))),
             repeat: Some(Radial(count: 6, axis_point: (0.0, 0.8, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
        Part(id: "fruit-stage", name: "Fruit stage", parent: None,
             description: "The same flower later on: the ovary has swollen into a fruit around the seeds, and the petals and stamens have fallen.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "fruit", name: "Fruit", parent: Some("fruit-stage"),
             description: "The ripened ovary. It protects the seeds and helps to spread them.",
             colour: (0.85, 0.35, 0.20),
             geometry: Some(Ellipsoid(centre: (0.0, 2.2, 0.0), radii: (4.2, 5.0, 4.2), wall: Some(0.6)))),
        Part(id: "seeds", name: "Seeds", parent: Some("fruit-stage"),
             description: "Each seed grew from an ovule that was fertilised. It can grow into a new plant.",
             colour: (0.45, 0.30, 0.15),
             geometry: Some(Ellipsoid(centre: (2.0, 2.2, 0.0), radii: (0.6, 0.85, 0.5))),
             repeat: Some(Radial(count: 6, axis_point: (0.0, 2.2, 0.0), axis_dir: (0.0, 1.0, 0.0)))),
    ],
    // Outermost first: the order of removal when peeling.
    layers: [
        Layer(id: "fruit-stage", name: "Fruit stage", parts: ["fruit-stage"]),
        Layer(id: "petals", name: "Petals", parts: ["petals"]),
        Layer(id: "sepals", name: "Sepals", parts: ["sepals"]),
        Layer(id: "stamens", name: "Stamens", parts: ["stamens"]),
        Layer(id: "carpel", name: "Carpel", parts: ["carpel"]),
    ],
    views: [
        View(id: "flower", name: "The flower",
             camera: Some((yaw_deg: 30.0, pitch_deg: 25.0, zoom: 1.0)),
             show: ["flower"], peel: 0, section: None),
        View(id: "carpel-only", name: "The carpel, lengthwise",
             camera: Some((yaw_deg: 20.0, pitch_deg: 10.0, zoom: 1.4)),
             show: ["carpel"], peel: 0, section: Some((axis: Z, offset: 0.0, flip: false))),
        View(id: "fruit", name: "After pollination: the fruit",
             camera: Some((yaw_deg: 0.0, pitch_deg: 0.0, zoom: 1.5)),
             show: ["fruit-stage"], peel: 0, section: Some((axis: Z, offset: 0.0, flip: false))),
    ],
    // A fixed account of what happens after pollination, told in five beats. The fruit stage
    // starts hidden (its first action is Show) and replaces the ovary at the end, because a
    // part cannot change shape; the ovary and ovules swell first so the swap is not a jump.
    // Timings are for reading, not measured.
    timelines: [
        Timeline(id: "pollination", name: "From flower to fruit",
            camera: Some((yaw_deg: 30.0, pitch_deg: 25.0, zoom: 1.0)),
            scenes: [
                Scene(id: "pollination", beats: [
                    Beat(id: "flower", actions: [
                        Narrate(text: "A flower. The anthers make pollen; the ovary holds the ovules.", for_s: 4.0),
                        Highlight(part: "anthers"),
                    ]),
                    Beat(id: "pollen-lands", actions: [
                        Narrate(text: "An insect carries pollen to the sticky stigma.", for_s: 4.0),
                        Highlight(part: "stigma"),
                        Camera(yaw_deg: 20.0, pitch_deg: 10.0, zoom: 1.5, for_s: 3.0, ease: Smooth),
                    ]),
                    Beat(id: "tube", actions: [
                        Narrate(text: "A pollen tube grows down the style to the ovules, and fertilises them.", for_s: 4.0),
                        Highlight(part: "style"),
                        Highlight(part: "ovules"),
                    ]),
                    Beat(id: "fall", actions: [
                        Narrate(text: "The petals and stamens have done their job and fall away. The ovary swells.", for_s: 4.0),
                        Move(part: "petals", by: (0.0, -14.0, 0.0), for_s: 4.0, ease: Smooth),
                        Move(part: "stamens", by: (0.0, -14.0, 0.0), for_s: 4.0, ease: Smooth),
                        Grow(part: "ovary", to: 1.7, for_s: 4.0, ease: Smooth),
                        Grow(part: "ovules", to: 1.6, for_s: 4.0, ease: Smooth),
                    ]),
                    Beat(id: "fruit", actions: [
                        Hide(part: "petals"),
                        Hide(part: "stamens"),
                        Hide(part: "carpel"),
                        Show(part: "fruit-stage"),
                        Narrate(text: "The ovary has become a fruit. Each fertilised ovule has become a seed.", for_s: 4.0),
                        Camera(yaw_deg: 0.0, pitch_deg: 0.0, zoom: 1.5, for_s: 3.0, ease: Smooth),
                    ]),
                ]),
            ]),
    ],
)
