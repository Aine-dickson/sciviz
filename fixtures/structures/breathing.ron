// Breathing: rib cage, diaphragm, lungs and airways, schematic. Proportions are invented, NOT measured data.
// Proof of concept for the item register (docs/item-output-bar.md); not for lessons as it stands.
// Axis is +Y (head up), the front of the body is +Z. Units are cm.
// It shows the fixed account of how air moves in and out (the muscles and ribs change the size of the chest);
// it does not show gas exchange in the air sacs, the heart, or the pleura. The air particles only show the direction
// of flow; their speed and number are not measured.
// The rib cage is 7 ribs (an open ring round the chest with a gap at the back where the spine would be) and a
// sternum; real people have 12 pairs of ribs. Lungs, bronchi are one part each, mirrored left and right.
Structure(
    version: 1,
    name: "Breathing: rib cage, diaphragm, lungs and airways (schematic)",
    units: "cm",
    reference: "To be confirmed by the author: textbook account of ventilation (the diaphragm contracts and flattens, the external intercostal muscles raise the ribs, the chest volume rises, the pressure inside falls and air flows in; the reverse for breathing out). Schematic proportions; the typical resting breathing rate for children is a rounded textbook range.",
    circle_segments: 32,
    parts: [
        Part(id: "chest", name: "Chest", parent: None,
             description: "The rib cage, the diaphragm, the lungs and the airways that lead to them.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "ribs", name: "Ribs", parent: Some("chest"),
             description: "Bones that curve round the chest and protect the lungs. Muscles between the ribs lift them when you breathe in. (Seven are shown; people have twelve pairs.)",
             colour: (0.93, 0.89, 0.78),
             geometry: Some(Tube(path: [(-1.760, 0.0, -4.443), (-3.400, 0.0, -3.984), (-4.808, 0.0, -3.253), (-5.889, 0.0, -2.300), (-6.568, 0.0, -1.191), (-6.800, 0.0, 0.000), (-6.568, 0.0, 1.191), (-5.889, 0.0, 2.300), (-4.808, 0.0, 3.253), (-3.400, 0.0, 3.984), (-1.760, 0.0, 4.443), (0.000, 0.0, 4.600), (1.760, 0.0, 4.443), (3.400, 0.0, 3.984), (4.808, 0.0, 3.253), (5.889, 0.0, 2.300), (6.568, 0.0, 1.191), (6.800, 0.0, 0.000), (6.568, 0.0, -1.191), (5.889, 0.0, -2.300), (4.808, 0.0, -3.253), (3.400, 0.0, -3.984), (1.760, 0.0, -4.443)], half_widths: [(0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25), (0.35, 0.25)], up: (0.0, 1.0, 0.0))),
             repeat: Some(Linear(count: 7, step: (0.0, 1.8, 0.0)))),
        Part(id: "sternum", name: "Breastbone (sternum)", parent: Some("chest"),
             description: "The flat bone at the front of the chest that the ribs join. It moves up and forward a little when you breathe in.",
             colour: (0.88, 0.84, 0.72), opacity: 0.6,
             geometry: Some(Tube(path: [(0.0, 8.0, 4.9), (0.0, 13.0, 5.0), (0.0, 19.5, 4.8)], half_widths: [(0.5, 0.25), (0.5, 0.25), (0.5, 0.25)], up: (0.0, 0.0, 1.0)))),
        Part(id: "diaphragm", name: "Diaphragm", parent: Some("chest"),
             description: "A dome-shaped sheet of muscle under the lungs. When it tightens it flattens and moves down, which makes the chest bigger.",
             colour: (0.78, 0.35, 0.38),
             geometry: Some(Ellipsoid(centre: (0.0, 5.2, 0.0), radii: (6.2, 2.3, 4.2)))),
        Part(id: "lungs", name: "Lungs", parent: Some("chest"),
             description: "Two soft, spongy organs. They fill with air when you breathe in. They do not have muscles of their own: they are pulled bigger when the chest gets bigger.",
             colour: (0.95, 0.62, 0.68), opacity: 0.45,
             geometry: Some(Ellipsoid(centre: (3.6, 12.9, 0.1), radii: (2.8, 5.2, 3.0))),
             mirror: Some(X)),
        Part(id: "airways", name: "Airways", parent: Some("chest"),
             description: "The windpipe and the two tubes that branch from it, carrying air to and from the lungs.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "trachea", name: "Windpipe (trachea)", parent: Some("airways"),
             description: "The tube that carries air from the nose and mouth down towards the lungs.",
             colour: (0.80, 0.70, 0.85), opacity: 0.4,
             geometry: Some(Tube(path: [(0.0, 23.0, 0.0), (0.0, 20.0, 0.0), (0.0, 16.8, 0.0)], half_widths: [(0.6, 0.6), (0.6, 0.6), (0.6, 0.6)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bronchi", name: "Bronchi", parent: Some("airways"),
             description: "The windpipe divides into two tubes, one for each lung.",
             colour: (0.80, 0.70, 0.85), opacity: 0.4,
             geometry: Some(Tube(path: [(0.0, 16.8, 0.0), (1.6, 15.6, 0.0), (3.4, 14.2, 0.0), (3.6, 12.5, 0.0)], half_widths: [(0.45, 0.45), (0.4, 0.4), (0.4, 0.4), (0.35, 0.35)], up: (0.0, 0.0, 1.0))),
             mirror: Some(X)),
    ],
    // Outermost first: the order of removal when peeling.
    layers: [
        Layer(id: "rib-cage", name: "Rib cage", parts: ["ribs", "sternum"]),
        Layer(id: "lungs", name: "Lungs", parts: ["lungs"]),
        Layer(id: "diaphragm", name: "Diaphragm", parts: ["diaphragm"]),
        Layer(id: "airways", name: "Airways", parts: ["airways"]),
    ],
    views: [
        View(id: "front", name: "The chest from the front",
             camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.0)),
             show: ["chest"], peel: 0, section: None),
        View(id: "side", name: "The chest from the side",
             camera: Some((yaw_deg: 135.0, pitch_deg: -20.0, zoom: 1.0)),
             show: ["chest"], peel: 0, section: None),
        View(id: "airways", name: "The airways",
             camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.2)),
             show: ["airways", "lungs"], peel: 0, section: None),
    ],
    // One breath in and out, then a second pair of breaths at a normal pace.
    timelines: [
        Timeline(id: "breathing", name: "How we breathe in and out",
            camera: Some((yaw_deg: 45.0, pitch_deg: -25.0, zoom: 1.0)),
            scenes: [
                Scene(id: "breathing", beats: [
                    Beat(id: "rest", actions: [
                        Narrate(text: "Your lungs sit inside the rib cage, above a dome of muscle called the diaphragm.", for_s: 5.0),
                        Highlight(part: "diaphragm"),
                    ]),
                    Beat(id: "in", actions: [
                        Narrate(text: "Breathing in: the diaphragm tightens and moves down, and the ribs move up and out.", for_s: 4.0),
                        Narrate(text: "The space in the chest gets bigger, so air flows in through the windpipe and fills the lungs.", for_s: 3.0, at_s: 4.0),
                        Move(part: "diaphragm", by: (0.0, -1.8, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "ribs", by: (0.0, 0.5, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "sternum", by: (0.0, 0.5, 0.4), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "ribs", to: 1.08, for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "lungs", by: (0.0, -0.5, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "lungs", to: 1.15, for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Flow(id: "in-a-right", count: 10, path: [(0.0, 23.0, 0.0), (0.0, 20.0, 0.0), (0.0, 16.8, 0.0), (1.6, 15.6, 0.0), (3.4, 14.2, 0.0), (3.6, 12.5, 0.0)], speed: 3.2, lateral: 0.2, seed: 1, particle_radius: 0.17, colour: (0.55, 0.85, 1.0), for_s: 7.0, at_s: 0.0),
                        Flow(id: "in-a-left", count: 10, path: [(-0.0, 23.0, 0.0), (-0.0, 20.0, 0.0), (-0.0, 16.8, 0.0), (-1.6, 15.6, 0.0), (-3.4, 14.2, 0.0), (-3.6, 12.5, 0.0)], speed: 3.2, lateral: 0.2, seed: 2, particle_radius: 0.17, colour: (0.55, 0.85, 1.0), for_s: 7.0, at_s: 0.0),
                    ]),
                    Beat(id: "out", actions: [
                        Narrate(text: "Breathing out: the diaphragm relaxes and moves back up, and the ribs move down and in.", for_s: 4.0),
                        Narrate(text: "The space in the chest gets smaller, so air is pushed out of the lungs.", for_s: 3.0, at_s: 4.0),
                        Move(part: "diaphragm", by: (0.0, 1.8, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "ribs", by: (0.0, -0.5, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "sternum", by: (0.0, -0.5, -0.4), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "ribs", to: 1.0, for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Move(part: "lungs", by: (0.0, 0.5, 0.0), for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "lungs", to: 1.0, for_s: 7.0, at_s: 0.0, ease: Smooth),
                        Flow(id: "out-a-right", count: 10, path: [(3.6, 12.5, 0.0), (3.4, 14.2, 0.0), (1.6, 15.6, 0.0), (0.0, 16.8, 0.0), (0.0, 20.0, 0.0), (0.0, 23.0, 0.0)], speed: 3.2, lateral: 0.2, seed: 1, particle_radius: 0.17, colour: (0.80, 0.80, 0.85), for_s: 7.0, at_s: 0.0),
                        Flow(id: "out-a-left", count: 10, path: [(-3.6, 12.5, 0.0), (-3.4, 14.2, 0.0), (-1.6, 15.6, 0.0), (-0.0, 16.8, 0.0), (-0.0, 20.0, 0.0), (-0.0, 23.0, 0.0)], speed: 3.2, lateral: 0.2, seed: 2, particle_radius: 0.17, colour: (0.80, 0.80, 0.85), for_s: 7.0, at_s: 0.0),
                    ]),
                    Beat(id: "again", actions: [
                        Narrate(text: "It goes on without you thinking about it: in, out, in, out. At rest, children breathe about 18 to 25 times every minute.", for_s: 10.0),
                        Move(part: "diaphragm", by: (0.0, -1.8, 0.0), for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Move(part: "ribs", by: (0.0, 0.5, 0.0), for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Move(part: "sternum", by: (0.0, 0.5, 0.4), for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "ribs", to: 1.08, for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Move(part: "lungs", by: (0.0, -0.5, 0.0), for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Grow(part: "lungs", to: 1.15, for_s: 5.0, at_s: 0.0, ease: Smooth),
                        Flow(id: "in-b-right", count: 10, path: [(0.0, 23.0, 0.0), (0.0, 20.0, 0.0), (0.0, 16.8, 0.0), (1.6, 15.6, 0.0), (3.4, 14.2, 0.0), (3.6, 12.5, 0.0)], speed: 3.2, lateral: 0.2, seed: 1, particle_radius: 0.17, colour: (0.55, 0.85, 1.0), for_s: 5.0, at_s: 0.0),
                        Flow(id: "in-b-left", count: 10, path: [(-0.0, 23.0, 0.0), (-0.0, 20.0, 0.0), (-0.0, 16.8, 0.0), (-1.6, 15.6, 0.0), (-3.4, 14.2, 0.0), (-3.6, 12.5, 0.0)], speed: 3.2, lateral: 0.2, seed: 2, particle_radius: 0.17, colour: (0.55, 0.85, 1.0), for_s: 5.0, at_s: 0.0),
                        Move(part: "diaphragm", by: (0.0, 1.8, 0.0), for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Move(part: "ribs", by: (0.0, -0.5, 0.0), for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Move(part: "sternum", by: (0.0, -0.5, -0.4), for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Grow(part: "ribs", to: 1.0, for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Move(part: "lungs", by: (0.0, 0.5, 0.0), for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Grow(part: "lungs", to: 1.0, for_s: 5.0, at_s: 5.0, ease: Smooth),
                        Flow(id: "out-b-right", count: 10, path: [(3.6, 12.5, 0.0), (3.4, 14.2, 0.0), (1.6, 15.6, 0.0), (0.0, 16.8, 0.0), (0.0, 20.0, 0.0), (0.0, 23.0, 0.0)], speed: 3.2, lateral: 0.2, seed: 1, particle_radius: 0.17, colour: (0.80, 0.80, 0.85), for_s: 5.0, at_s: 5.0),
                        Flow(id: "out-b-left", count: 10, path: [(-3.6, 12.5, 0.0), (-3.4, 14.2, 0.0), (-1.6, 15.6, 0.0), (-0.0, 16.8, 0.0), (-0.0, 20.0, 0.0), (-0.0, 23.0, 0.0)], speed: 3.2, lateral: 0.2, seed: 2, particle_radius: 0.17, colour: (0.80, 0.80, 0.85), for_s: 5.0, at_s: 5.0),
                    ]),
                ]),
            ]),
    ],
)
