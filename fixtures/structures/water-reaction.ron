// Hydrogen and oxygen reacting to make water: 2 H₂ + O₂ → 2 H₂O. Schematic.
// Proof of concept for the item register (docs/item-output-bar.md); not for lessons as it stands.
// Bond lengths and the H-O-H angle follow the usual textbook values (H-H 0.74, O=O 1.21, O-H 0.96 angstrom, H-O-H 104.5 degrees).
// Atoms are drawn as small balls (ball-and-stick), not at their real sizes. This is NOT the reaction mechanism: in reality the
// reaction goes through several steps with short-lived particles, and the atoms do not move in straight lines. The picture shows
// what a learner needs: the same atoms before and after, joined differently. The atoms keep one position per instant; the old
// bonds fade out as the atoms move and the new bonds appear when they have arrived (they are drawn at the atoms' final positions).
// The scene lies in the XY plane and faces +Z. Units are angstrom.
Structure(
    version: 1,
    name: "Hydrogen and oxygen make water (2H₂ + O₂ → 2H₂O)",
    units: "angstrom",
    reference: "To be confirmed by the author: textbook account of a chemical reaction as the rearrangement of atoms (bonds break, new bonds form, atoms are conserved), using the formation of water from hydrogen and oxygen. Bond lengths and the H-O-H angle are standard textbook values. Schematic.",
    circle_segments: 24,
    parts: [
        Part(id: "reaction", name: "Hydrogen and oxygen reacting", parent: None,
             description: "Two hydrogen molecules and one oxygen molecule react to make two water molecules.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "hydrogen", name: "Hydrogen atoms", parent: Some("reaction"),
             description: "Four hydrogen atoms (white). Each has one proton and one electron.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "oxygen", name: "Oxygen atoms", parent: Some("reaction"),
             description: "Two oxygen atoms (red).",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "h1", name: "Hydrogen atom 1", parent: Some("hydrogen"),
             description: "A hydrogen atom, the lightest atom. Atoms are drawn as balls; real atoms have no sharp edge.",
             colour: (0.95, 0.95, 0.95),
             geometry: Some(Ellipsoid(centre: (-6.000000000, 2.500000000, 0.0), radii: (0.28, 0.28, 0.28)))),
        Part(id: "h2", name: "Hydrogen atom 2", parent: Some("hydrogen"),
             description: "A hydrogen atom, the lightest atom. Atoms are drawn as balls; real atoms have no sharp edge.",
             colour: (0.95, 0.95, 0.95),
             geometry: Some(Ellipsoid(centre: (-5.260000000, 2.500000000, 0.0), radii: (0.28, 0.28, 0.28)))),
        Part(id: "h3", name: "Hydrogen atom 3", parent: Some("hydrogen"),
             description: "A hydrogen atom, the lightest atom. Atoms are drawn as balls; real atoms have no sharp edge.",
             colour: (0.95, 0.95, 0.95),
             geometry: Some(Ellipsoid(centre: (-6.000000000, -2.500000000, 0.0), radii: (0.28, 0.28, 0.28)))),
        Part(id: "h4", name: "Hydrogen atom 4", parent: Some("hydrogen"),
             description: "A hydrogen atom, the lightest atom. Atoms are drawn as balls; real atoms have no sharp edge.",
             colour: (0.95, 0.95, 0.95),
             geometry: Some(Ellipsoid(centre: (-5.260000000, -2.500000000, 0.0), radii: (0.28, 0.28, 0.28)))),
        Part(id: "o1", name: "Oxygen atom 1", parent: Some("oxygen"),
             description: "An oxygen atom. It can make two bonds.",
             colour: (0.85, 0.15, 0.15),
             geometry: Some(Ellipsoid(centre: (0.000000000, 0.605000000, 0.0), radii: (0.45, 0.45, 0.45)))),
        Part(id: "o2", name: "Oxygen atom 2", parent: Some("oxygen"),
             description: "An oxygen atom. It can make two bonds.",
             colour: (0.85, 0.15, 0.15),
             geometry: Some(Ellipsoid(centre: (0.000000000, -0.605000000, 0.0), radii: (0.45, 0.45, 0.45)))),
        Part(id: "bonds-before", name: "Bonds in the starting molecules", parent: Some("reaction"),
             description: "The bonds that hold the atoms together in hydrogen, H2, and oxygen, O2, before the reaction.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "bond-h1h2", name: "Bond in hydrogen molecule 1", parent: Some("bonds-before"),
             description: "A single bond: one shared pair of electrons holds the two hydrogen atoms together.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(-6.000000000, 2.500000000, 0.0), (-5.630000000, 2.500000000, 0.0), (-5.260000000, 2.500000000, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bond-h3h4", name: "Bond in hydrogen molecule 2", parent: Some("bonds-before"),
             description: "A single bond: one shared pair of electrons holds the two hydrogen atoms together.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(-6.000000000, -2.500000000, 0.0), (-5.630000000, -2.500000000, 0.0), (-5.260000000, -2.500000000, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bond-o1o2", name: "Double bond in the oxygen molecule", parent: Some("bonds-before"),
             description: "A double bond (two lines): two shared pairs of electrons hold the two oxygen atoms together.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(-0.170000000, 0.605000000, 0.0), (-0.170000000, 0.000000000, 0.0), (-0.170000000, -0.605000000, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0))),
             repeat: Some(Linear(count: 2, step: (0.34, 0.0, 0.0)))),
        Part(id: "bonds-after", name: "Bonds in the water molecules", parent: Some("reaction"),
             description: "The new bonds between oxygen and hydrogen atoms in water, H2O.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "bond-o1h1", name: "Bond between oxygen 1 and hydrogen 1", parent: Some("bonds-after"),
             description: "A single bond between oxygen and hydrogen in water.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(4.000000000, 2.400000000, 0.0), (3.706135706, 2.779530995, 0.0), (3.412271411, 3.159061991, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bond-o1h2", name: "Bond between oxygen 1 and hydrogen 2", parent: Some("bonds-after"),
             description: "A single bond between oxygen and hydrogen in water.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(4.000000000, 2.400000000, 0.0), (3.706135706, 2.020469005, 0.0), (3.412271411, 1.640938009, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bond-o2h3", name: "Bond between oxygen 2 and hydrogen 3", parent: Some("bonds-after"),
             description: "A single bond between oxygen and hydrogen in water.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(4.000000000, -2.400000000, 0.0), (3.706135706, -2.020469005, 0.0), (3.412271411, -1.640938009, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
        Part(id: "bond-o2h4", name: "Bond between oxygen 2 and hydrogen 4", parent: Some("bonds-after"),
             description: "A single bond between oxygen and hydrogen in water.",
             colour: (0.62, 0.62, 0.68),
             geometry: Some(Tube(path: [(4.000000000, -2.400000000, 0.0), (3.706135706, -2.779530995, 0.0), (3.412271411, -3.159061991, 0.0)], half_widths: [(0.09, 0.09), (0.09, 0.09), (0.09, 0.09)], up: (0.0, 0.0, 1.0)))),
    ],
    layers: [],
    views: [],
    timelines: [
        Timeline(id: "reaction", name: "Hydrogen and oxygen make water",
            camera: Some((yaw_deg: 45.0, pitch_deg: -27.0, zoom: 1.2)),
            scenes: [
                Scene(id: "reaction", beats: [
                    Beat(id: "before", actions: [
                        Narrate(text: "Hydrogen and oxygen are gases. Their atoms are joined in pairs: two molecules of hydrogen, H₂ (white), and one molecule of oxygen, O₂ (red). Count the atoms: 4 hydrogen and 2 oxygen.", for_s: 9.0),
                        Highlight(part: "bonds-before"),
                    ]),
                    Beat(id: "break", actions: [
                        Narrate(text: "When they react, the old bonds between the atoms break.", for_s: 5.0),
                        Fade(part: "bonds-before", to: 0.0, for_s: 2.0, ease: Smooth),
                        Move(part: "o1", by: (4.000000000, 1.795000000, 0.0), for_s: 3.0, at_s: 1.5, ease: Smooth),
                        Move(part: "o2", by: (4.000000000, -1.795000000, 0.0), for_s: 3.0, at_s: 1.5, ease: Smooth),
                    ]),
                    Beat(id: "join", actions: [
                        Narrate(text: "The atoms move and join up in a new way: each oxygen atom meets two hydrogen atoms.", for_s: 6.0),
                        Move(part: "h1", by: (9.412271411, 0.659061991, 0.0), for_s: 5.0, ease: Smooth),
                        Move(part: "h2", by: (8.672271411, -0.859061991, 0.0), for_s: 5.0, ease: Smooth),
                        Move(part: "h3", by: (9.412271411, 0.859061991, 0.0), for_s: 5.0, ease: Smooth),
                        Move(part: "h4", by: (8.672271411, -0.659061991, 0.0), for_s: 5.0, ease: Smooth),
                    ]),
                    Beat(id: "new-bonds", actions: [
                        Narrate(text: "New bonds form. Each oxygen atom is now bonded to two hydrogen atoms: two molecules of water, H₂O. The water molecule is bent, with an angle of about 104.5 degrees between its two bonds.", for_s: 9.0),
                        Show(part: "bonds-after"),
                        Highlight(part: "bonds-after"),
                    ]),
                    Beat(id: "count", actions: [
                        Narrate(text: "Count the atoms again: 4 hydrogen and 2 oxygen, the same as before. No atoms were made or lost: they were only rearranged. We write it as 2H₂ + O₂ → 2H₂O.", for_s: 10.0),
                        Highlight(part: "hydrogen"),
                        Highlight(part: "oxygen"),
                    ]),
                ]),
            ]),
    ],
)
