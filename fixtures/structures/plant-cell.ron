// Generic plant leaf cell, schematic. Proportions are invented, NOT measured data. Units are micrometres.
// Proof of concept for the item register (docs/item-output-bar.md); not for lessons as it stands.
// Light-microscope level only (syllabus area CEL): cell wall, membrane, vacuole, nucleus, chloroplasts,
// mitochondria. The cytoplasm fills the space inside the membrane but is not drawn, so the organelles stay visible.
Structure(
    version: 1,
    name: "Generic plant cell (leaf)",
    units: "um",
    reference: "To be confirmed by the author: standard textbook plant cell at light-microscope level. Schematic proportions, not measured.",
    circle_segments: 40,
    parts: [
        Part(id: "cell", name: "Plant cell", parent: None,
             description: "A typical leaf cell. It has a wall, a membrane, a large vacuole, a nucleus and chloroplasts.",
             colour: (0.5, 0.5, 0.5), geometry: None),
        Part(id: "cell-wall", name: "Cell wall", parent: Some("cell"),
             description: "A tough layer of cellulose outside the membrane. It gives the cell its shape and supports the plant.",
             colour: (0.80, 0.85, 0.55),
             geometry: Some(Ellipsoid(centre: (0.0, 0.0, 0.0), radii: (24.0, 16.0, 16.0), wall: Some(1.2)))),
        Part(id: "cell-membrane", name: "Cell membrane", parent: Some("cell"),
             description: "A thin skin just inside the wall. It controls what goes into and out of the cell.",
             colour: (0.95, 0.75, 0.45),
             geometry: Some(Ellipsoid(centre: (0.0, 0.0, 0.0), radii: (22.6, 14.6, 14.6), wall: Some(0.3)))),
        Part(id: "vacuole", name: "Large vacuole", parent: Some("cell"),
             description: "A big sac of cell sap. It keeps the cell firm and stores water and dissolved substances.",
             colour: (0.65, 0.80, 0.95),
             geometry: Some(Ellipsoid(centre: (2.0, 0.0, 0.0), radii: (12.0, 8.0, 8.0), wall: Some(0.4)))),
        Part(id: "chloroplasts", name: "Chloroplasts", parent: Some("cell"),
             description: "Green bodies where photosynthesis happens (eight shown). They make food from light, water and carbon dioxide.",
             colour: (0.20, 0.60, 0.25),
             geometry: Some(Ellipsoid(centre: (8.0, 12.5, 0.0), radii: (1.8, 1.0, 1.2))),
             repeat: Some(Radial(count: 8, axis_point: (8.0, 0.0, 0.0), axis_dir: (1.0, 0.0, 0.0)))),
        Part(id: "mitochondria", name: "Mitochondria", parent: Some("cell"),
             description: "Small bodies that release energy from food by respiration (six shown).",
             colour: (0.85, 0.35, 0.30),
             geometry: Some(Ellipsoid(centre: (-6.0, 11.5, 0.0), radii: (1.4, 0.55, 0.55))),
             repeat: Some(Radial(count: 6, axis_point: (-6.0, 0.0, 0.0), axis_dir: (1.0, 0.0, 0.0)))),
        Part(id: "nucleus", name: "Nucleus", parent: Some("cell"),
             description: "The control centre. It holds the genetic material that directs the cell.",
             colour: (0.55, 0.40, 0.75),
             geometry: Some(Ellipsoid(centre: (-16.0, 0.0, 0.0), radii: (4.0, 4.0, 4.0), wall: Some(0.4)))),
        Part(id: "nucleolus", name: "Nucleolus", parent: Some("nucleus"),
             description: "A dense spot inside the nucleus.",
             colour: (0.35, 0.22, 0.55),
             geometry: Some(Ellipsoid(centre: (-16.0, 0.0, 0.0), radii: (1.3, 1.3, 1.3)))),
    ],
    // Outermost first: the order of removal when peeling.
    layers: [
        Layer(id: "cell-wall", name: "Cell wall", parts: ["cell-wall"]),
        Layer(id: "cell-membrane", name: "Cell membrane", parts: ["cell-membrane"]),
        Layer(id: "vacuole", name: "Vacuole", parts: ["vacuole"]),
        Layer(id: "chloroplasts", name: "Chloroplasts", parts: ["chloroplasts"]),
        Layer(id: "mitochondria", name: "Mitochondria", parts: ["mitochondria"]),
        Layer(id: "nucleus", name: "Nucleus", parts: ["nucleus"]),
    ],
    views: [
        View(id: "whole", name: "The whole cell",
             camera: Some((yaw_deg: 30.0, pitch_deg: 25.0, zoom: 1.0)),
             show: [], peel: 0, section: None),
        View(id: "inside", name: "Inside the cell (wall and membrane removed)",
             camera: Some((yaw_deg: 30.0, pitch_deg: 25.0, zoom: 1.0)),
             show: [], peel: 2, section: None),
        View(id: "cut", name: "Cut through the middle",
             camera: Some((yaw_deg: 20.0, pitch_deg: 10.0, zoom: 1.0)),
             show: [], peel: 0, section: Some((axis: Z, offset: 0.0, flip: false))),
    ],
)
