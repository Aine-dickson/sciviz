        Timeline(id: "dissolving", name: "Salt dissolving in water",
            camera: Some((yaw_deg: 30.0, pitch_deg: -40.0, zoom: 1.8)),
            scenes: [
                Scene(id: "salt", beats: [
                    Beat(id: "crystal", actions: [
                        Narrate(text: "This is a tiny piece of a crystal of salt, sodium chloride (NaCl). It is made of ions packed tightly together: sodium ions, Na⁺ (small, purple), and chloride ions, Cl⁻ (large, green). One grain of table salt holds about a billion billion of them.", for_s: 10.0),
                    ]),
                    Beat(id: "smaller", actions: [
                        Narrate(text: "To see the pattern, the ions are now drawn smaller. They sit on a regular cubic grid, sodium and chloride taking turns in every direction. The grey lines only show the grid: they are not bonds.", for_s: 9.0),
