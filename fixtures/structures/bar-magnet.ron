                    Beat(id: "lines", actions: [
                        Narrate(text: "If we draw the paths a compass would follow, we get magnetic field lines. Outside the magnet they leave the north pole and curve round into the south pole.", for_s: 10.0),
                        Show(part: "field-lines"),
                        Highlight(part: "field-lines"),
                    ]),
                    Beat(id: "strength", actions: [
                        Narrate(text: "The lines are crowded together near the poles, where the magnet is strongest. Far away they spread out, where the field is weak. The lines are only a way of drawing the field: it fills all the space around the magnet.", for_s: 12.0),
                    ]),
                    Beat(id: "compasses", actions: [
                        Narrate(text: "Put compasses anywhere around the magnet and they point along the field lines. Near the north pole they point away from it; near the south pole they point towards it.", for_s: 10.0),
                        Show(part: "compasses"),
                    ]),
                ]),
            ]),
    ],
)
