// The simple circuit, written as an item document (docs/item-document.md). The circuit kit places the parts,
// routes the wires, and lights the lamp and moves the electrons exactly while the loop is complete.
Item(
    id: "simple-circuit",
    title: "A simple circuit with a switch",
    subject: Physics,
    idea: "A current flows only round a complete circuit.",
    reference: "To be confirmed by the author: textbook account of a simple series circuit (cell, switch, filament lamp): current flows only in a complete circuit, is the same all round a series loop, and is carried in metals by electrons moving from the negative to the positive terminal; conventional current is drawn from positive to negative.",
    objects: [
        Cell(id: "cell", kind: AA),
        Switch(id: "switch", starts: Open),
        Lamp(id: "lamp", kind: MES),
        Loop(["cell", "switch", "lamp"]),
    ],
    story: [
        Beat(id: Some("parts"),
             say: "A simple circuit. The cell pushes charge round. Copper wires join it to a switch and a lamp. Every part is joined into one loop.",
             point_at: ["cell", "wire", "switch", "lamp"],
             label: ["cell.positive", "cell.negative"]),
        Beat(id: Some("open"),
             say: "The switch is open: its lever is up, leaving a gap. The loop is broken, so no charge flows round. There is no current, and the lamp is off.",
             point_at: ["switch.lever"]),
        Beat(id: Some("close"),
             say: "Close the switch. The lever touches the contact and the loop is complete.",
             do: [Close("switch")]),
        Beat(id: Some("current"),
             say: "Now there is a current. Electrons were already in all the metal. They all start to move at once, out of the negative terminal, round the loop and back into the positive terminal. So the lamp lights straight away.",
             label: ["lamp.filament"]),
        Beat(id: Some("same"),
             say: "The current is the same everywhere in the loop: in every wire, through the switch, the filament and the cell. No charge is used up; it goes round and round."),
        Beat(id: Some("energy"),
             say: "The cell gives the charge energy. In the thin filament that energy is transferred as heat and light. Real electrons drift slowly, under a millimetre a second; here they are shown much faster."),
        Beat(id: Some("off"),
             say: "Open the switch again. The gap breaks the loop: the current stops everywhere at once, and the lamp goes out.",
             do: [Open("switch")],
             point_at: ["switch.lever"]),
        Beat(id: Some("summary"),
             say: "A current flows only round a complete circuit, and a switch makes or breaks the loop. Circuit diagrams show the conventional current, from the positive terminal to the negative, the opposite way to the electrons."),
    ],
)
